<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#001A33">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/etTituloNota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Título de la Nota"
            android:inputType="textCapSentences"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A7E72"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etContenidoNota"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:minHeight="120dp"
            android:gravity="top"
            android:hint="Escribe tus notas aquí..."
            android:inputType="textMultiLine"
            android:textColor="#FFFFFF"
            android:textColorHint="#8A7E72"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnGuardarNota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FF6600"
            android:padding="12dp"
            android:text="Guardar Nota"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>